<?xml version="1.0"?>
<ruleset name="AroundWire">
	<description>WordPress Coding Standards for the AroundWire theme.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Template files are named after the template hierarchy, not after classes. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="aw"/>
				<element value="AW"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<!-- Theme helpers that return already escaped markup. -->
			<property name="customEscapingFunctions" type="array">
				<element value="aw_style"/>
				<element value="aw_url_field"/>
				<element value="aw_attr_field"/>
				<element value="aw_inline_svg"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="aroundwire"/>
			</property>
		</properties>
	</rule>
</ruleset>
